{
  "worktree": { "bgIsolation": "none" },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx prisma format:*)",
      "Bash(sqlite3:*)",
      "Bash(curl -s:*)",
      "Bash(node -e:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(ls:*)",
      "Bash(cmp:*)",
      "Fetch(*)"
    ]
  },
  "env": {
    "MAX_THINKING_TOKENS": "12000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"
  }
}
