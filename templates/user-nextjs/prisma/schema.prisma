generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal starter model — Coder extends this schema per task.
model Item {
  id        String    @id @default(cuid())
  title     String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}
