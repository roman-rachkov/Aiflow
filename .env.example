# =============================================================================
# AI Studio (AIFlow) — environment template
# Copy to `.env` at the repo root, then fill secrets. `.env` is gitignored.
#
# Primary path: `docker compose up` (compose injects this file into Node
# services). Values below use compose DNS hostnames (`postgres`, `minio`, …).
# Host-only Next (`yarn workspace @aiflow/web dev`) needs `localhost` in
# DATABASE_URL / S3_ENDPOINT instead.
# =============================================================================

# Run mode: dev | prod (reserved; compose topology is the same for now)
ENVIRONMENT=dev

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=ai_studio
POSTGRES_PASSWORD=ai_studio
# Compose overrides DATABASE_URL on `app`/`worker` to the same credentials at
# host `postgres`. Keep this in sync with POSTGRES_* for scripts/seed on host.
DATABASE_URL=postgresql://ai_studio:ai_studio@postgres:5432/ai_studio?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- MinIO (S3-compatible object storage) ------------------------------------
# Scheme-less host:port is accepted (apps/web shared/minio).
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-studio

# --- Gitea -------------------------------------------------------------------
# Inside the compose network Gitea listens on :3000; published on host :3002.
GITEA_URL=http://gitea:3000
# Optional override. Compose `gitea-init` mints a token into the shared volume
# at GITEA_ADMIN_TOKEN_FILE after every fresh `down -v` (idempotent). Prefer
# that file in app/worker; set this only for host-side scripts.
GITEA_ADMIN_TOKEN=
# GITEA_ADMIN_TOKEN_FILE=/run/gitea/token
# Owner user/org for new project repos (apps/web shared/gitea). Default aistudio.
# GITEA_REPO_OWNER=aistudio
# GITEA_ADMIN_PASSWORD=aistudio-dev-pass
# GITEA_ADMIN_EMAIL=aistudio@example.com
# Used by the Gitea container (GITEA__security__SECRET_KEY). Set a long random
# string before first start; changing it later invalidates sessions.
GITEA_SECRET_KEY=

# --- App listen address ------------------------------------------------------
# HTTP bind for apps/web/server.ts. Do NOT set Docker HOSTNAME here — that is
# the container id and breaks the 127.0.0.1 healthcheck. Compose sets
# LISTEN_HOST=0.0.0.0 on `app`.
# LISTEN_HOST=0.0.0.0

# --- Model router (stub service today) ---------------------------------------
AI_ROUTER_URL=http://model-router:3001

# --- Encryption --------------------------------------------------------------
# AES-256-GCM master key for ModelConfig.config. Must decode to 32 bytes.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Auth.js / NextAuth v5 ---------------------------------------------------
# Browser-facing origin (host port 3000). Auth.js reads AUTH_* only (v5).
AUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Sandbox / worker (Task 3.1) --------------------------------------------
# Compose network name is `{project}_sandbox`. Override if COMPOSE_PROJECT_NAME
# differs from the default derived from the repo directory.
# SANDBOX_NETWORK=aiflow_sandbox
# AIDER_SANDBOX_IMAGE=aistudio/aider-sandbox:latest

# --- OpenAI-compatible LLM (@aiflow/ai-roles) --------------------------------
# One adapter for chat + embeddings (z.ai, OpenAI, LM Studio, Ollama, …).
# Empty OPENAI_API_KEY → MOCK (canned chat + deterministic 768-d vectors).
# Any non-empty key → LIVE HTTP against OPENAI_BASE_URL.
#
# Docker → process on the Windows/macOS host: use host.docker.internal, not
# localhost. LM Studio / Ollama must listen on 0.0.0.0 (not only 127.0.0.1).
#
# Examples:
#   LM Studio:  OPENAI_BASE_URL=http://host.docker.internal:1234/v1
#               OPENAI_API_KEY=lm-studio
#   z.ai:       OPENAI_BASE_URL=https://api.z.ai/api/paas/v4
#   OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1
#
# Embedding dim MUST match DocumentChunk.embedding vector(768) in
# packages/db (nomic-embed-text = 768). Do not use text-embedding-3-small
# (1536) without changing the schema + VECTOR_DDL.
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=qwen/qwen3-coder-30b
OPENAI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
