# =============================================================================
# AI Studio (AIFlow) — environment variable template
# Copy to .env and fill in. .env is not tracked (see .gitignore).
# Source of values: docs/10-infrastructure.md (x-common-env block).
# =============================================================================

# Run mode: dev | prod
ENVIRONMENT=dev

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=ai_studio
POSTGRES_PASSWORD=ai_studio
DATABASE_URL=postgresql://ai_studio:ai_studio@postgres:5432/ai_studio?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- MinIO (S3-compatible storage) -------------------------------------------
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-studio

# --- Gitea -------------------------------------------------------------------
# Port 3000 inside the network; published on 3002 externally.
GITEA_URL=http://gitea:3000
GITEA_ADMIN_TOKEN=
GITEA_SECRET_KEY=

# --- Model Router ------------------------------------------------------------
AI_ROUTER_URL=http://model-router:3001

# --- Encryption --------------------------------------------------------------
# Exactly 32 bytes. Used by AES-256-GCM to encrypt ModelConfig.config.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- NextAuth ----------------------------------------------------------------
# NextAuth v5 reads AUTH_SECRET / AUTH_URL. The NEXTAUTH_* names are the v4
# spelling, still honoured, kept so an existing .env keeps working.
AUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- LLM providers -----------------------------------------------------------
# User keys are stored encrypted in the DB. These are platform-level keys,
# for system tasks and as fallback (see docs/02-architecture.md § 2.5).
ROUTERAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OpenAI-compatible provider (used by @aiflow/ai-roles). Drives both streaming
# chat and embeddings. Absent/empty OPENAI_API_KEY selects MOCK mode (canned
# replies + deterministic vectors) so dev + tests run with no network/key.
# OPENAI_BASE_URL defaults to OpenAI; z.ai uses https://api.z.ai/api/paas/v4.
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY above is the platform key; ZAI_API_KEY is the z.ai alias.
ZAI_API_KEY=
OPENAI_CHAT_MODEL=glm-4.6
# ZAI_MODEL is the z.ai alias of OPENAI_CHAT_MODEL.
ZAI_MODEL=glm-4.6
# text-embedding-3-small produces 1536-dim vectors (matches pgvector schema).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
