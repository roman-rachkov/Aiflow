{
  "name": "@aiflow/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema_project_template.prisma",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "project-sql": "tsx scripts/generate-project-sql.ts",
    "backfill:threads": "tsx scripts/backfill-threads.ts",
    "seed:dev-user": "tsx scripts/seed-dev-user.ts",
    "typecheck": "yarn generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "pg": "^8.13.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/pg": "^8.11.10",
    "bcryptjs": "2.4.3",
    "typescript": "^5.6.0"
  }
}
