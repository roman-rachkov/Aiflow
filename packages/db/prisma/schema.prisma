// AI Studio — public schema (shared data)
//
// Only User, ProjectMeta and DeploymentMeta live here, plus the NextAuth
// adapter models. Everything else is per-project — see
// schema_project_template.prisma.
//
// See docs/03-data-model.md § 2.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Explicit output: two schemas generating into the same default location
  // would collide. Resolves decision C2 in docs/14-decisions-needed.md.
  output   = "../generated/public"
}

// Platform user.
//
// `role` and `uiMode` are deliberately separate concerns:
//   - role   — authorization. Only USER is exercised in MVP; ADMIN and OWNER
//              are carried so the future admin panel needs no migration.
//   - uiMode — presentation. This is what the earlier documents called
//              "Customer" and "Engineer": two modes of one application,
//              switched by the user, not a permission boundary.
//
// `image`, `emailVerified` and `passwordHash` serve NextAuth. The first two are
// named by the adapter contract, not by us — @auth/prisma-adapter writes them
// directly, so they cannot be renamed to house style. `passwordHash` backs the
// dev-only Credentials provider (see docs/14-decisions-needed.md).
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  role          UserRole  @default(USER)
  uiMode        UiMode    @default(BASIC)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete: domain models are never physically removed. A timestamp here
  // marks the row as deleted; queries must filter `deletedAt: null` manually
  // (no Prisma extension — explicit is safer than magical auto-filtering).
  deletedAt     DateTime?

  projects ProjectMeta[]
  accounts Account[]
  sessions Session[]
}

enum UserRole {
  OWNER
  ADMIN
  USER
}

enum UiMode {
  BASIC
  PRO
}

// Project metadata — the pointer to the project's own schema.
model ProjectMeta {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  schemaName  String        @unique // e.g. project_abc123
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  // Soft delete — see the convention on User. `deletedAt` is the single
  // deletion mechanism; the former ProjectStatus.DELETED value was removed to
  // avoid two indicators that can disagree.
  deletedAt   DateTime?

  deployments DeploymentMeta[]

  @@index([ownerId])
  @@index([deletedAt])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Deploy summary. Full build logs live in the project schema (Deployment).
model DeploymentMeta {
  id        String           @id @default(uuid())
  projectId String
  project   ProjectMeta      @relation(fields: [projectId], references: [id])
  status    DeploymentStatus @default(BUILDING)
  url       String?
  createdAt DateTime         @default(now())
  // Soft delete — see the convention on User.
  deletedAt DateTime?

  @@index([projectId, createdAt])
}

enum DeploymentStatus {
  BUILDING
  DEPLOYED
  FAILED
}

// --- NextAuth adapter models -------------------------------------------------

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
