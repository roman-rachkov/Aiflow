{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    // `paths` replaces the base config's map rather than merging with it, so
    // every @aiflow/* alias must be repeated here. Kept in sync with
    // tsconfig.base.json so any @aiflow/* package resolves in this app.
    "paths": {
      "@/*": ["./src/*"],
      "@aiflow/db": ["../../packages/db/src"],
      "@aiflow/queue": ["../../packages/queue/src"],
      "@aiflow/crypto": ["../../packages/crypto/src"],
      "@aiflow/ai-roles": ["../../packages/ai-roles/src"],
      "@aiflow/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "server.ts", ".next/types/**/*.ts"],
  // Dev scripts (rag-mcp, ingest) run under tsx; their MCP SDK subpath
  // imports do not resolve under this package's moduleResolution and must
  // not block `yarn typecheck` for the Next app.
  "exclude": ["scripts"],
  "references": []
}
