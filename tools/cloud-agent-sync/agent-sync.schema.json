{
  "$id": "https://aiflow.local/schemas/agent-sync.schema.json",
  "title": "Cloud Agent Tools Sync",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cacheDir": {
      "type": "string",
      "description": "Directory for cloned git remotes, relative to repo root.",
      "default": ".cursor/.agent-sync-cache"
    },
    "overwrite": {
      "type": "boolean",
      "description": "When true, replace existing synced files. Default false (skip existing).",
      "default": false
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Destination dirs for skill folders (each contains SKILL.md)."
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Destination dirs for slash-command .md files."
        },
        "agents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Destination dirs for subagent .md files."
        },
        "hooks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Destination dirs for hookify.*.local.md files."
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["git"],
            "properties": {
              "git": {
                "type": "string",
                "description": "Git remote URL (HTTPS or SSH)."
              },
              "ref": {
                "type": "string",
                "description": "Branch, tag, or commit. Default main.",
                "default": "main"
              },
              "layout": {
                "type": "string",
                "enum": ["standard", "flat-skills"],
                "default": "standard",
                "description": "standard: skills/, commands/, agents/, hooks/ subdirs. flat-skills: skill dirs at repo root."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["local"],
            "properties": {
              "local": {
                "type": "string",
                "description": "Local path (supports ~). Skipped when missing (e.g. on Cloud Agent VMs)."
              },
              "as": {
                "type": "string",
                "enum": ["skills", "tree"],
                "default": "skills",
                "description": "skills: treat path as skills/ container or flat skill dirs. tree: full standard layout."
              },
              "layout": {
                "type": "string",
                "enum": ["standard", "flat-skills"],
                "default": "standard"
              }
            }
          }
        ]
      }
    }
  },
  "required": ["sources"]
}
